<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in cookies stay on this phone (Android 12+ backups and transfers). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="youtube_account.txt"/>
        <exclude domain="file" path="tiktok_cookies.txt"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="youtube_account.txt"/>
        <exclude domain="file" path="tiktok_cookies.txt"/>
    </device-transfer>
</data-extraction-rules>
